# =========================================================================
# Unity .gitignore Oficial Recomendado
# =========================================================================

# Carpetas temporales generadas por Unity (NUNCA deben ir a Git)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Cache de Asset Store y paquetes descargados
/[Aa]ssets/AssetStoreTools*

# Archivos de la base de datos de Asset Import (si usaste versiones antiguas de Unity)
/[Aa]ssets/Plugins/Editor/JetBrains*

# Archivos ejecutables generados tras compilar el juego
*.apk
*.aab
*.unitypackage
*.app

# =========================================================================
# Archivos de Proyectos e IDEs (Visual Studio, VS Code, Rider)
# =========================================================================
# Proyectos de C# autogenerados por Unity
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Configuración de entornos de desarrollo específicos
.consulo/
.idea/
*.sln.docstates
.vscode/

# Configuración de sistema operativo
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db

# =========================================================================
# Unity Cloud Build / Servicios en la Nube
# =========================================================================
sysinfo.txt

# =========================================================================
# Crash Reports y Logs de Rendimiento
# =========================================================================
*.log
